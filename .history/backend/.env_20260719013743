# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/hrms

# --- Auth -----------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Server ----------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Email (used for credentials, OTP, offer letters) ----------------------------
# For Gmail: use an "App Password", not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="HRMS Enterprise <youraddress@gmail.com>"
